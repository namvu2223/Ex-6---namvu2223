<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Grades</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            padding: 30px;
            font-family: sans-serif;
        }
        
        .custom-select-style {
            max-width: 150px; 
            background-color: red !important; 
            color: white !important; 
        }
       
         .custom-select-style option {
             background-color: white;
             color: black;
         }


    </style>
</head>
<body>

    <h1 style="font-weight: bold">Student Grade Viewer</h1>

    <form action="/" method="post" class="d-flex align-items-center mb-3">
        <label for="studentSelect" class="form-label me-2 fw-bold">Select a student:</label>
        <select name="studentId" id="studentSelect" class="form-select custom-select-style me-2" required>
             <option value="" disabled <%= typeof selectedStudentId === 'undefined' ? 'selected' : '' %>>-- Select --</option>
            <% if (typeof students !== 'undefined' && students.length > 0) { %>
                <% students.forEach(student => { %>
                    <option value="<%= student.id %>" <%= (typeof selectedStudentId !== 'undefined' && student.id == selectedStudentId) ? 'selected' : '' %>>
                        <%= student.name %>
                    </option>
                <% }); %>
            <% } %>
        </select>
        <button type="submit" class="btn btn btn-outline-danger">Submit</button>
    </form>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-warning" role="alert">
            <%= error %>
        </div>
    <% } %>

    <% if (typeof avgHomework !== 'undefined' && typeof avgExam !== 'undefined') { %>
        <div class="border rounded p-3 d-inline-block"> 
            <p class="mb-1"><span class="text-danger fw-bold">Average Homework Grade:</span> <%= avgHomework.toFixed(2) %></p> 
            <p class="mb-0"><span class="text-danger fw-bold">Average Exam Grade:</span> <%= avgExam.toFixed(2) %></p> 
        </div>
    <% } %>


</body>
</html>